# ============================================================
# MOD Việt Hóa — Git ignore
# Chỉ lưu source, cấu hình mẫu và static assets có chủ đích.
# Không lưu dữ liệu runtime, upload production hoặc secret.
# ============================================================

# Dependencies / package-manager caches
/node_modules/
/.pnp
/.pnp.*
/.pnpm-store/
/.yarn/cache/
/.yarn/unplugged/
/.yarn/install-state.gz

# Next.js / build outputs
/.next/
/out/
/build/
/dist/

# TypeScript caches
*.tsbuildinfo

# Tests / coverage
/coverage/
/playwright-report/
/test-results/

# Logs
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Private keys / local credentials
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
/secrets/
/credentials/
service-account*.json

# Vercel / deployment-local state
/.vercel/

# IDE
/.vscode/
/.idea/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Runtime JSON data
# Các file này chứa user, comment, review, notification,
# mod/version, donate, audit log và báo cáo production.
# ------------------------------------------------------------
/data/*.json
/data/**/*.json
/data/backups/

# Chỉ cho phép tài liệu, schema và dữ liệu mẫu đã khử thông tin
!/data/*.example.json
!/data/**/*.example.json
!/data/*.schema.json
!/data/**/*.schema.json
!/data/README.md
!/data/**/README.md

# Future local database runtime
/data/*.db
/data/*.db-*
/data/*.sqlite
/data/*.sqlite-*
/data/*.sqlite3
/data/*.sqlite3-*

# ------------------------------------------------------------
# Runtime storage / uploads
# ------------------------------------------------------------
/storage/
/public/uploads/
/public/storage/
/public/runtime/

# Community media là static asset có chủ đích và ĐƯỢC commit:
# public/community-media/**

# QR ngân hàng cũ chứa thông tin tài chính và không còn dùng
/public/images/support/techcombank-donation-qr.jpg

# PM2 local state
/.pm2/

# Backup / quarantine directories generated by maintenance scripts
*-patch-backups/
*-runtime-backups/
*runtime-quarantine*/
*runtime-backup*/
*quarantine*/
/backups/

# Temporary and editor-backup files
*.tmp
*.temp
*.bak
*.cache
*.swp
*.swo
*~

# Root-level packaging artifacts
/*.zip
/*.rar
/*.7z
/*.tar
/*.tar.gz
/*.tgz