# Public canonical URL used by every production redirect and absolute link.
APP_URL=https://modviethoa.vn
NEXT_PUBLIC_SITE_URL=https://modviethoa.vn

# Use one secret name consistently in production. Minimum 32 characters.
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai-va-bao-mat
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-dai-va-bao-mat

# SePay Donate Phase 1.
# Create a Live webhook with HMAC-SHA256 and store the generated secret here.
SEPAY_AUTOMATION_ENABLED=true
SEPAY_WEBHOOK_SECRET=thay-bang-secret-hmac-sepay
SEPAY_WEBHOOK_TOLERANCE_SECONDS=300
SEPAY_MONTHLY_FREE_LIMIT=50

# Legacy fallback only. Leave empty when the webhook uses HMAC-SHA256.
SEPAY_WEBHOOK_API_KEY=

